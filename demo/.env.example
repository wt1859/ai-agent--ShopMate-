# Optional real Jev intent classifier. Leave blank for offline local routing.
TYPESAFE_API_KEY=
JEV_MODEL=jev-latest
JEV_API_BASE=https://api.typesafe.ai

# Optional OpenAI-compatible chat + embedding API.
# These enable natural-language responses and real dense embeddings.
# Leave blank to use offline demo responses + local char-TF-IDF dense proxy.
OPENAI_API_KEY=
OPENAI_API_BASE=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Optional custom data file. Defaults to demo/data/demo.sqlite3.
# DEMO_DB_PATH=
